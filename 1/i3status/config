general {
        output_format = "i3bar"
        colors = true
        interval = 1
}
order += "memory"
order += "cpu_usage"
order += "load"
order += "ethernet enp4s0"
order += "read_file text"
order += "disk /"
order += "tztime local"

load {
    format = "%15min waiting"
}

tztime local {
        format = "%m-%d-%Y %H:%M:%S"
}

memory {
        format = "%used MEM"
        threshold_degraded = "10%"
        format_degraded = "MEMORY: %free"
}
cpu_usage {
    format = "%usage CPU"
}
read_file text {
    path = "/home/pc2/c"
}

ethernet enp4s0 {
		format_up = "ON"
		format_down = "OFF"
}
disk "/" {
        format = "%free"
}

