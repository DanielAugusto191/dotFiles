# Mako configuration adapted from ~/.config/dunst/dunstrc
font=FiraCode 10
anchor=top-right
layer=overlay
width=700
height=600
margin=10,10,50
padding=2,8
border-size=1
border-color=#ffffff
border-radius=5
background-color=#1e1e2e
text-color=#ffffff
icons=1
max-icon-size=128
default-timeout=10000
ignore-timeout=0
on-notify=exec paplay "$HOME/.config/notify/1.wav"

[urgency=low]
background-color=#1e1e2e
border-color=#3fb950
default-timeout=10000

[urgency=normal]
background-color=#1e1e2e
border-color=#f2cc60
default-timeout=10000

[urgency=critical]
background-color=#1e1e2e
border-color=#f85149
default-timeout=0
ignore-timeout=1

[app-name=volume]
background-color=#0000aa

[app-name=discord]
background-color=#000000
